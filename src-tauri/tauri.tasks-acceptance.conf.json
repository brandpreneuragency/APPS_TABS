{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TABS Tasks Acceptance",
  "identifier": "com.tabs.tasks.acceptance",
  "app": {
    "windows": [{ "label": "main", "title": "TABS Tasks Acceptance", "create": false,
      "width": 1100, "height": 760, "minWidth": 900, "minHeight": 600,
      "center": true, "decorations": true, "dragDropEnabled": false }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-src 'none'",
      "capabilities": [{ "identifier": "tasks-acceptance", "windows": ["main"],
        "permissions": ["core:default", "tasks-acceptance-only"] }]
    }
  },
  "plugins": { "updater": { "active": false, "endpoints": [] } },
  "bundle": { "active": false, "createUpdaterArtifacts": false, "fileAssociations": [] }
}
